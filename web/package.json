{
  "name": "drop-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build:wasm": "wasm-pack build ../crypto-wasm --target web --out-dir ../web/src/wasm",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:wasm && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.0",
    "svelte": "^5.56.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
