# Rust and web build state
/target/
# The network lab's rendezvous helper is its own cargo project, so its build
# directory is not under the root one the line above covers. Its `Cargo.lock`
# *is* committed: it builds a binary rather than a library, and a lab whose
# dependency versions drift between runs would produce findings about the
# drift.
/netlab/rendezvous/target/
# Built from `crypto-wasm/` by `npm --prefix web run build:wasm`.
/web/src/wasm/
/node_modules/
/web/node_modules/

# Python state from the network lab in netlab/
__pycache__/
.venv/
.pytest_cache/

# Local tools, editors, and operating-system state
/.claude/settings.local.json
/.codex/
/.idea/
/.vscode/
*.swp
*.swo
*~
.DS_Store

# Secrets and local configuration
.env
.env.*
!.env.example
!**/.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# Logs and coverage
*.log
/coverage/
